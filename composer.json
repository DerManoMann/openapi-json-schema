{
    "name": "radebatz/openapi-json-schema",
    "description": "Describes classes without OpenAPI attributes in the document swagger-php builds, using the schemas symfony/json-schema generates from PropertyInfo, the serializer and validator constraints.",
    "keywords": [
        "openapi",
        "swagger",
        "swagger-php",
        "json-schema",
        "symfony"
    ],
    "license": [
        "MIT"
    ],
    "homepage": "https://github.com/DerManoMann/openapi-json-schema",
    "authors": [
        {
            "name": "Martin Rademacher",
            "email": "mano@radebatz.org"
        }
    ],
    "support": {
        "issues": "https://github.com/DerManoMann/openapi-json-schema/issues",
        "source": "https://github.com/DerManoMann/openapi-json-schema"
    },
    "scripts": {
        "cs": "export XDEBUG_MODE=off && php-cs-fixer fix --allow-risky=yes",
        "rector": "rector process src tests",
        "lint": [
            "@cs --dry-run",
            "@rector --dry-run"
        ],
        "test": "export XDEBUG_MODE=off && phpunit",
        "analyse": [
            "export XDEBUG_MODE=off && phpstan analyse --memory-limit=2G"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Radebatz\\OpenApi\\JsonSchema\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Radebatz\\OpenApi\\JsonSchema\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "phpdocumentor/type-resolver": "^1.10",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/json-schema": "8.2.x-dev",
        "zircote/swagger-php": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.62.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.0"
    }
}
